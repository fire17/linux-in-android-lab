<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ld_app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/ld_tagline"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="10dp"
            android:background="#22888888"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <!-- Omarchy lane: first-run Arch Linux ARM download progress (hidden unless a download runs). -->
        <ProgressBar
            android:id="@+id/rootfs_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:visibility="gone" />

        <!-- Omarchy lane: the guest distro. Literal labels (the strings files belong to other lanes). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distro"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/distro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/distro_alpine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alpine (default: Chromium, no window manager)" />

            <RadioButton
                android:id="@+id/distro_omarchy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Omarchy (Arch Linux ARM: Chrome + i3 with Omarchy's look; first run downloads ~1.6 GB and needs ~4 GB free)" />
        </RadioGroup>

        <!-- Sway lane, experimental and OFF by default: Omarchy runs sway instead of i3 (K/linux/Desktop.kt). -->
        <CheckBox
            android:id="@+id/desktop_sway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ld_desktop_sway" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ld_start" />

            <Button
                android:id="@+id/btn_open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ld_open_desktop"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ld_stop" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_restart_browser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_restart_browser" />

        <Button
            android:id="@+id/btn_genie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_genie_open" />

        <!-- Literal label: the strings files belong to other lanes; storage keeps its texts inline (ReviewActivity.S). -->
        <Button
            android:id="@+id/btn_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Storage" />

        <Button
            android:id="@+id/btn_hw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_hw_open" />

        <Button
            android:id="@+id/btn_ota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_ota_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ld_home_url"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:hint="https://www.google.com/" />

        <RadioGroup
            android:id="@+id/mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/mode_browser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ld_mode_browser" />

            <RadioButton
                android:id="@+id/mode_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ld_mode_app" />

            <RadioButton
                android:id="@+id/mode_kiosk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ld_mode_kiosk" />
        </RadioGroup>

        <TextView
            android:id="@+id/scale_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <SeekBar
            android:id="@+id/scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150" />

        <CheckBox
            android:id="@+id/opt_auto_kbd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ld_opt_auto_kbd" />

        <CheckBox
            android:id="@+id/opt_legacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ld_opt_legacy" />

        <CheckBox
            android:id="@+id/opt_noseccomp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ld_opt_noseccomp" />

        <!-- GPU acceleration (gpu/GpuSession.kt): experimental, default OFF; disabled + explained on non-Adreno phones. -->
        <CheckBox
            android:id="@+id/opt_gpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ld_opt_gpu_v2" />

        <TextView
            android:id="@+id/gpu_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:textSize="12sp"
            android:text="@string/ld_gpu_hint" />

        <!-- Sound out (audio/AudioOut.kt): guest audio plays on the phone speaker. Default ON. Live (audio/SoundSwitch). -->
        <CheckBox
            android:id="@+id/opt_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ld_opt_sound" />

        <!-- ld-perf recommendation, OFF until Tami approves: ~200 ms AudioTrack buffer instead of ~40 ms. -->
        <CheckBox
            android:id="@+id/opt_sound_smooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/ld_opt_sound_smooth" />

        <!-- Microphone to Linux (audio/MicIn.kt). Default OFF, never persisted, resets when the session ends. -->
        <Switch
            android:id="@+id/opt_mic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ld_mic_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_mic_help"
            android:textSize="12sp" />

        <!-- Foreground-only mic (audio/MicForeground.kt). Default OFF = the mic pauses when LinuxDesk leaves the screen. -->
        <CheckBox
            android:id="@+id/opt_mic_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ld_opt_mic_background" />

        <!-- Phone camera for Linux (camera/CameraServer.kt). Default OFF, never persisted, resets when the session ends. -->
        <Switch
            android:id="@+id/opt_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ld_camera_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_camera_help"
            android:textSize="12sp" />

        <!-- Cameras v3: relay-only privacy mode. Default OFF (Tami decides). -->
        <CheckBox
            android:id="@+id/opt_camera_relay_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_camera_relay_only" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:background="#22FFAA00"
            android:text="@string/ld_phantom_help"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_dev_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ld_open_dev_options" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ld_sandbox_warning"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ld_log"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_share_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ld_share_logs" />

            <Button
                android:id="@+id/btn_copy_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ld_copy_log" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#FF101010">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:fontFamily="monospace"
                android:textColor="#FFB0F0B0"
                android:textIsSelectable="true"
                android:textDirection="ltr"
                android:textSize="11sp" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ld_license"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
