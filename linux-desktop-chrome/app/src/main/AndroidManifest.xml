<?xml version="1.0" encoding="utf-8"?>
<!--
  LinuxDesk. The merged manifest also contains everything from upstream lorie's manifest
  (third_party/termux-x11/lorie/src/main/AndroidManifest.xml): LorieApp$Receiver, which receives the
  X server's ACTION_START broadcast; LoriePreferences; the KeyInterceptor accessibility service; and
  others. This file overrides only what has to differ.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- iroh watches the network to find its addresses and home relay; Storage Genie declares this too. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Microphone to Linux (audio/MicIn.kt). Requested at runtime ONLY when the person turns the in-app switch
         ON; default OFF. The genie link cannot turn it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Genie link, fs.* verbs (storage lane). Requested only when the person opens Storage; sideloaded APK only
         (spec 02 #11). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".LinuxDeskApp"
        tools:replace="android:name"
        android:allowBackup="false"
        android:icon="@mipmap/ld_ic_launcher"
        android:label="@string/ld_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinuxDesk">

        <!-- Setup and status screen. It routes straight to the desktop once a session is running. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Linux display. It subclasses com.termux.x11.MainActivity, whose LorieView (a SurfaceView)
             is where the embedded X server renders. Attributes copied from upstream's MainActivity
             declaration: lorie expects to handle rotation and keyboard itself, without being recreated. -->
        <!-- Own task (like upstream's taskAffinity=".MainActivity"), so going back to the launcher does
             not destroy the display. -->
        <activity
            android:name=".DesktopActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.fire17.linuxdesk.desktop"
            android:theme="@style/LorieAppTheme"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- Upstream's own X11 window activity stays in the manifest, because lorie's code references it,
             but it must not appear in the launcher (Termux:X11 icon) or offer home/shortcut entries. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            tools:node="merge">
            <intent-filter tools:node="removeAll" />
            <meta-data
                android:name="android.app.shortcuts"
                tools:node="remove" />
        </activity>

        <!-- Owns the whole session: rootfs, package setup, the X server binding, and the Chromium process tree. -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started Linux desktop session (X server + Chromium) alive while the user works in it." />
        </service>

        <!-- Genie link (spec 01): pairing screen (pair lane) and the storage screen / delete review sheet (storage
             lane). Neither is exported, so nothing outside the app can open the Approve sheet. -->
        <activity
            android:name=".genie.PairActivity"
            android:exported="false"
            android:label="@string/ld_genie_title" />

        <activity
            android:name=".storage.ReviewActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Storage" />

        <!-- Share logs (LogShare.kt): serves only cache/logs/ (res/xml/log_paths.xml), read access granted per
             share. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />
        </provider>

        <!-- The embedded X server (libXlorie) runs in its own process, as DroidDesk does. Its native threads
             cannot be stopped cleanly, so the process is killed when the session ends. -->
        <service
            android:name=".x11.X11ServerService"
            android:exported="false"
            android:process=":x11" />
    </application>
</manifest>
