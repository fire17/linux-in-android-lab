{
  "manifest_version": 3,
  "name": "LinuxDesk keyboard bridge",
  "version": "0.1.0",
  "description": "Tells the LinuxDesk Android app to show the soft keyboard when a text field is focused.",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
