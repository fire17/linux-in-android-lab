{
  "manifest_version": 3,
  "name": "LinuxDesk phone camera",
  "version": "0.1.0",
  "description": "Adds the phone's back camera as a \"Phone camera\" webcam for web pages (LinuxDesk).",
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "main.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
