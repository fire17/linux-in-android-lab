.gradle/
build/
app/build/
local.properties
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Fetched at CI/build time by scripts/fetch-*.sh. Never commit these.
third_party/
app/src/main/jniLibs/
app/src/main/assets/rootfs/
.fetch-cache/

# `gradle wrapper` can generate these. Only the properties file is committed.
gradle/wrapper/gradle-wrapper.jar
gradlew
gradlew.bat

# Genie link: the genie-client token files (spec 01 §4 rule 7). Never commit.
genie-client/**/*.json
**/genie-client/**/*.json
# Python bytecode from the shell lane's Mac test runs (would otherwise ship inside assets/linuxdesk/deskd).
__pycache__/
*.pyc
