<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backend"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgBackend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stream — real Android over scrcpy (redroid / emulator / spare phone)" />
            <RadioButton
                android:id="@+id/rbOnDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On-device — EXPERIMENT: proot ladder + AVF probe, reports how far it gets" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Stream target"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbDirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="adbd direct (:5555)" />
            <RadioButton
                android:id="@+id/rbAdbServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="adb server (:5037)" />
        </RadioGroup>

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="host (Tailscale IP / LAN IP)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="port"
            android:inputType="number" />

        <EditText
            android:id="@+id/etSerial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="serial (adb-server mode only, e.g. emulator-5554; blank = only device)"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etMaxSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="max size"
                android:inputType="number" />
            <EditText
                android:id="@+id/etBitrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Mbps"
                android:inputType="number" />
            <EditText
                android:id="@+id/etMaxFps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="fps"
                android:inputType="number" />
            <Spinner
                android:id="@+id/spCodec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNewDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="new_display (optional, e.g. 1080x2340/440)"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="On-device experiment"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbAvf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Also run AVF (hardware VM) probe" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Android userland (.tar.gz)…" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Start" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
